generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model MetricSnapshot {
  id              Int      @id @default(autoincrement())
  date            DateTime @unique @db.Date
  mrr             Int      // minor units (cents)
  arr             Int      // minor units (cents)
  churnRate       Float
  customerCount   Int
  netNewMRR       Int      // minor units (cents)
  arpc            Int      // minor units (cents)
  currency        String   @default("USD")
  createdAt       DateTime @default(now())

  @@index([date])
}
