{
  "buildCommand": "npm test && next build",
  "crons": [
    {
      "path": "/api/cron/snapshot",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/sync-activities",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/send-digest",
      "schedule": "0 7 1 * *"
    },
    {
      "path": "/api/cron/backfill?through=current",
      "schedule": "17 3 * * *"
    }
  ]
}
